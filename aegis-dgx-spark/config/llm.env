# Model runtime configuration. Sourced by aegis-llm.service and
# aegis-embed.service (llama.cpp llama-server).
#
# THIS REPO COPY IS A TEMPLATE: bootstrap/06-models.sh regenerates
# /aegis/config/llm.env with real paths after you choose and download
# models. The units refuse to start until the paths exist and match their
# sha256 entries in /aegis/config/models.toml.
#
# Sizing note: the Spark's memory is UNIFIED — model weights are mmap'd
# file-backed pages (reclaimable page cache), while the KV cache is
# anonymous memory that grows roughly linearly with context. The MemoryMax
# in the unit is a backstop against runaway KV growth, not a working-set
# target. If the box starts swapping, lower AEGIS_CTX_SIZE first.

AEGIS_MODEL_NAME=aegis-general
AEGIS_MODEL_PATH=/aegis/models/set-by-bootstrap-06.gguf
AEGIS_CTX_SIZE=32768
AEGIS_GPU_LAYERS=999
AEGIS_PARALLEL=2

AEGIS_EMBED_MODEL_NAME=aegis-embed
AEGIS_EMBED_MODEL_PATH=/aegis/models/set-by-bootstrap-06.gguf
AEGIS_EMBED_CTX=8192

# Debug escape only: skip the sha256 check in ExecStartPre.
#AEGIS_SKIP_MODEL_VERIFY=1
