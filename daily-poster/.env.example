# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is git-ignored).

# Your iha.ee account credentials (the account you want to post from)
IHA_USERNAME=your-username
IHA_PASSWORD=your-password

# Optional: run the browser visibly (true) instead of headless (false/unset).
# Useful the first time, to watch the login + post happen and debug selectors.
HEADFUL=false
